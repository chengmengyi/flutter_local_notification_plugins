<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fln_shortcut_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fln_shortcut_card_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp"
    android:weightSum="4">

    <LinearLayout
        android:id="@+id/fln_shortcut_home_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/fln_shortcut_home_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/home" />

        <TextView
            android:id="@+id/fln_shortcut_home_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fln_shortcut_merge_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/fln_shortcut_merge_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/merge" />

        <TextView
            android:id="@+id/fln_shortcut_merge_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fln_shortcut_import_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/fln_shortcut_import_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/shortcut_import" />

        <TextView
            android:id="@+id/fln_shortcut_import_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fln_shortcut_convert_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/fln_shortcut_convert_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/convert" />

        <TextView
            android:id="@+id/fln_shortcut_convert_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#000000"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
